# Se usar AI Gateway:
AI_GATEWAY_API_KEY=

# Se usar OpenRouter (opcional, quando API key estiver presente):
OPENROUTER_API_KEY=

# Modelo default para gateway/openrouter:
REVERSO_MODEL_ID=google/gemini-2.5-flash

# Paths de integração com o projeto legado:
REVERSO_LEGACY_ROOT=../agent
# REVERSO_FILESYSTEM_ROOT=../agent/filesystem

# Auto-accept padrão (true/false)
REVERSO_AUTO_ACCEPT_DEFAULT=false
