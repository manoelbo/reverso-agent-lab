# Required: Your OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Agent model (default: google/gemini-2.5-flash)
AGENT_MODEL=google/gemini-2.5-flash

# Path to the filesystem directory (relative to project root)
# Points to the agent's existing filesystem for shared data
AGENT_FILESYSTEM_DIR=../agent/filesystem

# Auto-accept: skip permission prompts (default: false)
AGENT_AUTO_ACCEPT=false

# Self-repair: attempt to fix invalid JSON from LLM (default: true)
AGENT_SELF_REPAIR=true
AGENT_SELF_REPAIR_ROUNDS=1

# Max output tokens for agent responses
AGENT_MAX_OUTPUT_TOKENS=16000
